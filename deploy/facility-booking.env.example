# Rivermont Spaces (facility-booking) — muni-demo QA environment.
#
# provision.sh renders this to @@APP_DIR@@/facility-booking.env on the server,
# filling in the generated secrets. It is chmod 600 and owned by the service
# account, loaded by systemd via EnvironmentFile, and NEVER overwritten by a
# later deploy or re-provision: config is server state, code is not.
#
# All keys are prefixed FB_ so they cannot clash with the co-located C2 and
# parking services on this box.

# ---- HTTP ----
FB_ENV=prod
# Loopback only. Apache terminates TLS and reverse-proxies to this port; the
# service must never be reachable from outside the box directly.
FB_ADDR=127.0.0.1:8094
# Empty: Apache strips the /facility-booking prefix before proxying, so the Go
# API serves /api/... and /healthz at its root. Leave blank unless you stop
# stripping in Apache — changing one without the other 404s every request.
FB_BASE_PATH=
FB_APP_ORIGIN=https://facility-booking.dev-pro.app

# HMAC key for the OIDC login-flow state cookie. Generated at provision time.
FB_SESSION_SECRET=@@SESSION_SECRET@@

# Uploaded waivers and insurance documents. OUTSIDE any web root, and the only
# path the systemd unit allows the service to write to.
FB_DATA_DIR=/app/facility-booking/data

# ---- Database ----
# MySQL 8 on this host (shared with C2 and parking). Same InnoDB engine,
# REPEATABLE READ isolation, SELECT ... FOR UPDATE and foreign-key enforcement
# that the booking path's double-booking prevention depends on.
#
# There is no fallback: the app refuses to start without a DSN, deliberately.
# A fallback would let it boot healthy while writing bookings somewhere nobody
# backs up.
FB_DB_DSN='facility_app:@@DB_PASSWORD@@@tcp(127.0.0.1:3306)/facility_booking?parseTime=true&loc=UTC&charset=utf8mb4'

# ---- Identity (OIDC via C2) ----
# C2 runs on this same box under /c2. Issuer and base URL are identical here
# because C2's own Apache vhost serves /c2/oidc directly — there is no browser
# proxy in between, unlike local dev.
FB_OIDC_ISSUER=https://muni-demo.dev-pro.app/c2/oidc
FB_OIDC_BASE_URL=https://muni-demo.dev-pro.app/c2/oidc
FB_OIDC_CLIENT_ID=@@OIDC_CLIENT_ID@@
FB_OIDC_CLIENT_SECRET=@@OIDC_CLIENT_SECRET@@
FB_OIDC_REDIRECT_URL=https://facility-booking.dev-pro.app/facility-booking/api/auth/callback
# Must be registered on the C2 client as a post_logout_redirect_uri or C2
# rejects the logout. Clearing only the local session would leave the C2 SSO
# session alive and the route guard would silently sign the user back in.
FB_OIDC_POST_LOGOUT_REDIRECT_URL=https://facility-booking.dev-pro.app/facility-booking/

# Comma-separated emails promoted to the admin role on login. This only fires
# if the app can learn the user's email — see FB_C2_API_URL below.
FB_ADMIN_EMAILS=jamie@celestialtech.ca

# ---- Notifications and payments (C2 partner API) ----
# The partner API is the machine-to-machine surface at {origin}/partner, a
# sibling of /oidc. Notifications AND the payment broker ride the same origin
# and the same client credentials above — there is no second set of secrets.
#
# This would default correctly here (FB_OIDC_BASE_URL minus /oidc), but it is
# set explicitly so that changing the OIDC URL cannot silently redirect
# server-to-server traffic somewhere else.
FB_C2_PARTNER_ORIGIN=https://muni-demo.dev-pro.app/c2

# This app's APPLICATION id in C2 — the service_provider_id on invoices, which
# C2 stamps as the `aud` of every payment status token. It is NOT the OIDC
# client id: that value would reject every settlement. Empty disables the
# callback outright, which is the safe failure — better to take no settlements
# than unverified ones.
FB_C2_APPLICATION_ID=@@C2_APPLICATION_ID@@

# Where C2 pushes signed settlement notices. Public, unauthenticated by design:
# C2 posts server-to-server with no session, and the RS256 signature over C2's
# published JWKS is the entire authentication.
FB_C2_PAYMENT_CALLBACK_URL=https://facility-booking.dev-pro.app/facility-booking/api/payments/c2/callback
FB_PAYMENT_CURRENCY=CAD

# ---- C2 identity lookup ----
# C2 releases only `sub` over OIDC, so the app tries the standard userinfo
# endpoint and falls back to C2's identity admin API to populate the header
# name and drive FB_ADMIN_EMAILS promotion. Read-only service credentials.
#
# Leave the URL empty to disable the fallback. If userinfo also returns
# nothing, users have no display name and nobody is auto-promoted to admin —
# promote an admin directly in the database instead.
FB_C2_API_URL=https://muni-demo.dev-pro.app/c2/api
FB_C2_SERVICE_USER=
FB_C2_SERVICE_PASS=

# ---- Central audit-logging service ----
# Already running on this box. Staff actions (approve, deny, refund, cancel,
# reschedule) are mirrored here append-only; the /staff/audit screen reads them
# back. Forwarding is best-effort and never blocks the action it describes, so
# an empty or rejected token costs the screen, not the booking.
FB_AUDIT_URL=http://127.0.0.1:8090
FB_AUDIT_TOKEN=

# ---- Service-card callout (C2 -> this app) ----
# C2 fetches GET /api/citizens/{sub}/status to render live booking info on the
# Rivermont Spaces card. FB_PUBLIC_APP_URL builds the links in that payload.
FB_PUBLIC_APP_URL=https://facility-booking.dev-pro.app/facility-booking
# FB_CONTACT_EMAIL=facilities@rivermont.ca
# FB_CONTACT_PHONE=+1 555-0142
# FB_CONTACT_ADDRESS1=215 Rivermont Way
# FB_CONTACT_CITY=Rivermont
# FB_CONTACT_STATE=ON
# FB_CONTACT_POSTAL=K2P 1L4

# ---- Branding ----
# Empty keeps the "Rivermont Spaces" demo identity, which is what the C2
# service card and consent policy are registered under. Changing it here means
# changing web/src/lib/brand.ts too — that is a build-time constant the API
# cannot read.
# FB_BRAND_NAME=
# FB_BRAND_SHORT_NAME=

# ---- Demo data ----
# Seeds 7 facilities and a deterministic year of bookings on an EMPTY database,
# so the reports dashboard has data on first load. Idempotent: it repopulates
# only when the facilities table is empty.
FB_SEED=true
