# Rendered from deploy/systemd/facility-booking.service.tmpl.
# Do not edit the rendered copy; it is overwritten on the next deploy.
[Unit]
Description=Rivermont Spaces (facility-booking) API
# Order after the database, or the service starts before MySQL accepts
# connections on boot and crash-loops until Restart happens to catch it.
After=network.target mysql.service
Wants=mysql.service

[Service]
Type=simple
User=@@USER@@
Group=@@USER@@
WorkingDirectory=@@APP_DIR@@
# All configuration and secrets come from this file (chmod 600, owned by the
# service account). Nothing is passed on the command line, where ps sees it.
EnvironmentFile=@@APP_DIR@@/@@SERVICE@@.env
ExecStart=@@APP_DIR@@/@@SERVICE@@
Restart=on-failure
RestartSec=3

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
# ProtectSystem=strict makes the whole filesystem read-only except these paths.
# The service writes exactly one thing: uploaded waivers and insurance
# documents under FB_DATA_DIR. Those are citizen-supplied files, which is why
# they live here — outside every web root — and are served back through the
# app rather than by Apache.
ReadWritePaths=@@APP_DIR@@/data

[Install]
WantedBy=multi-user.target
