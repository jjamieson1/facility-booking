# Facility Booking (Rivermont Spaces) — production environment.
# Copy to /app/facility-booking/facility-booking.env on the server and fill in
# real values. The systemd unit loads this via EnvironmentFile. All keys are
# prefixed FB_ so they never clash with a co-located C2 instance.

# ---- HTTP ----
FB_ENV=prod
# Listen address. The port MUST match the Apache ProxyPass target (:8094) and the
# deploy health check. Bound behind Apache; keep it loopback-only at the edge.
FB_ADDR=:8094
# Empty: Apache strips the /facility-booking prefix before proxying, so the Go
# API serves /api/... at the root. Leave blank unless you stop stripping in Apache.
FB_BASE_PATH=
# Public SPA origin — used for CORS and the post-login redirect. Same origin as
# the API behind Apache.
FB_APP_ORIGIN=https://facility-booking.celestialtech.ca

# HMAC key for the OIDC login-flow state cookie. Generate a long random value:
#   openssl rand -hex 32
FB_SESSION_SECRET=CHANGE_ME_LONG_RANDOM

# Where uploaded waiver/insurance docs are stored — OUTSIDE any web root, on the
# service's only writable path.
FB_DATA_DIR=/app/facility-booking/data

# ---- Database ----
# MariaDB is required and there is no fallback: the app refuses to start without
# a DSN, deliberately. A fallback would let it boot healthy while writing
# bookings to a local file nobody backs up.
#
# Create the database and the least-privilege app user first:
#   mariadb -u root -p < scripts/db-setup.sql     (set a real password in it)
#
# Do NOT grant the fbtest_% privileges from that script on this server — they
# exist only so a developer machine can create throwaway test databases.
FB_DB_DSN=facility_app:CHANGE_ME@tcp(127.0.0.1:3306)/facility_booking?parseTime=true&loc=UTC&charset=utf8mb4

# ---- Identity (OIDC via C2) ----
# Point these at the PRODUCTION C2. Register this app as an OIDC client in C2 with
# the redirect URL below (Authorization Code + PKCE). Issuer and base URL are the
# same when C2's web origin proxies /oidc (see CLAUDE.md for the dev gotcha).
FB_OIDC_ISSUER=https://<c2-host>/oidc
FB_OIDC_BASE_URL=https://<c2-host>/oidc
FB_OIDC_CLIENT_ID=CHANGE_ME
FB_OIDC_CLIENT_SECRET=CHANGE_ME
FB_OIDC_REDIRECT_URL=https://facility-booking.celestialtech.ca/facility-booking/api/auth/callback
# Where C2 returns the browser after RP-initiated logout (end_session). Must be
# registered on the C2 client as a post_logout_redirect_uri or C2 rejects it.
# Defaults to FB_APP_ORIGIN + "/".
FB_OIDC_POST_LOGOUT_REDIRECT_URL=https://facility-booking.celestialtech.ca/facility-booking/

# Comma-separated emails promoted to the admin role on login.
FB_ADMIN_EMAILS=jamie@celestialtech.ca

# ---- C2 identity lookup ----
# C2 releases only `sub` over OIDC, so name/email are fetched from C2's identity
# admin API by subject at login. Read-only service credentials. Empty URL disables.
FB_C2_API_URL=https://<c2-host>/api
FB_C2_SERVICE_USER=CHANGE_ME
FB_C2_SERVICE_PASS=CHANGE_ME

# ---- Central audit-logging service ----
# Staff/admin actions are mirrored here (append-only, tamper-evident). Empty URL
# disables forwarding; token is optional.
FB_AUDIT_URL=
FB_AUDIT_TOKEN=

# ---- Service-card callout (C2 -> this app) ----
# C2 fetches GET /api/citizens/{sub}/status (server-to-server, JWT-authenticated)
# to render live booking info on the Rivermont Spaces service card. Give the C2
# admin the callout URL:
#   https://facility-booking.celestialtech.ca/facility-booking/api/citizens/{sub}/status
# FB_PUBLIC_APP_URL builds the links returned in that payload — set it to the
# origin + SPA base so tasks/CTA point at the live SPA.
FB_PUBLIC_APP_URL=https://facility-booking.celestialtech.ca/facility-booking
# Static "contact us" block on the card (demo defaults apply if unset):
# FB_CONTACT_EMAIL=facilities@rivermont.ca
# FB_CONTACT_PHONE=+1 555-0142
# FB_CONTACT_ADDRESS1=215 Rivermont Way
# FB_CONTACT_CITY=Rivermont
# FB_CONTACT_STATE=ON
# FB_CONTACT_POSTAL=K2P 1L4

# ---- Demo data ----
# Seed a year of demo history on an EMPTY database. Set false for a clean prod.
FB_SEED=true
